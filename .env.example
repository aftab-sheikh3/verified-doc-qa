# Chat model: ollama (default, local) | openai | anthropic | fake (offline tests)
LLM_PROVIDER=ollama
# LLM_MODEL=qwen3:8b              # defaults: ollama qwen3:8b, openai gpt-4o-mini, anthropic claude-sonnet-5-5
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings follow LLM_PROVIDER (anthropic -> ollama): ollama nomic-embed-text, openai text-embedding-3-small
# EMBED_PROVIDER=ollama
# EMBED_MODEL=nomic-embed-text

# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Vector store: a Qdrant server, or embedded on-disk Qdrant in INDEX_DIR (one process at a time)
# QDRANT_URL=http://localhost:6333
# INDEX_DIR=data/index
# COLLECTION=docs

# Retrieval
# RETRIEVAL=hybrid                # dense | bm25 | hybrid
# HYBRID_WEIGHTS=0.4,0.6          # bm25, dense
# CANDIDATES_K=20
# TOP_N=5
# RERANKER=cross-encoder          # needs: pip install '.[rerank]'; "none" to disable
# RERANKER_MODEL=BAAI/bge-reranker-base
# CHUNK_SIZE=800
# CHUNK_OVERLAP=100
# CONTEXTUAL_CHUNKS=0             # 1 = an LLM writes a context sentence per chunk at ingest time

# Workflow
# MAX_ATTEMPTS=2                  # answer attempts before returning "unverified"

# Optional Langfuse tracing
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
